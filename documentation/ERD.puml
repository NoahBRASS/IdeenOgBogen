@startuml name ERD
title Idéen og Bogen - Opdateret ERD

hide circle
skinparam linetype ortho
skinparam entity {
    BackgroundColor #F8F8F8
    BorderColor #333333
}

' =========================
' Brugere og roller
' =========================

entity "Roles" as Roles {
    * RoleId : int <<PK>>
    --
    RoleName : varchar(50) <<UNIQUE>>
}

entity "Users" as Users {
    * UserId : int <<PK>>
    --
    RoleId : int <<FK>>
    Username : varchar(50) <<UNIQUE>>
    Email : varchar(100) <<UNIQUE>>
    PasswordHash : varchar(255)
    IsActive : bit
    CreatedAt : datetime
}

entity "Customers" as Customers {
    * CustomerId : int <<PK>>
    --
    UserId : int <<FK, UNIQUE>>
    FullName : varchar(100)
    Phone : varchar(20)
    Address : varchar(150)
    PostalCode : varchar(20)
    City : varchar(50)
}

' =========================
' Produkter og kategorier
' =========================

entity "Categories" as Categories {
    * CategoryId : int <<PK>>
    --
    ParentCategoryId : int <<FK, nullable>>
    Name : varchar(100)
    Description : varchar(255)
}

entity "ProductStatus" as ProductStatus {
    * ProductStatusId : int <<PK>>
    --
    StatusName : varchar(50)
    IsSellable : bit
}

entity "Products" as Products {
    * ProductId : int <<PK>>
    --
    CategoryId : int <<FK>>
    ProductStatusId : int <<FK>>
    Name : varchar(150)
    Description : varchar(500)
    Price : decimal(10,2)
    SKU : varchar(50) <<UNIQUE>>
    CreatedAt : datetime
}

entity "Inventory" as Inventory {
    * ProductId : int <<PK, FK>>
    --
    Quantity : int
    LastUpdated : datetime
}

' =========================
' Ordrer og betalinger
' =========================

entity "Orders" as Orders {
    * OrderId : int <<PK>>
    --
    CustomerId : int <<FK>>
    OrderDate : datetime
    OrderStatus : varchar(50)
    TotalAmount : decimal(10,2)
}

entity "OrderItems" as OrderItems {
    * OrderItemId : int <<PK>>
    --
    OrderId : int <<FK>>
    ProductId : int <<FK>>
    Quantity : int
    UnitPrice : decimal(10,2)
}

entity "Payments" as Payments {
    * PaymentId : int <<PK>>
    --
    OrderId : int <<FK, UNIQUE>>
    Amount : decimal(10,2)
    PaymentDate : datetime
    PaymentMethod : varchar(50)
    PaymentStatus : varchar(50)
}

' =========================
' Bøger og forfattere
' =========================

entity "BookDetails" as BookDetails {
    * ProductId : int <<PK, FK>>
    --
    ISBN : varchar(20) <<UNIQUE>>
    PublicationDate : date
    Publisher : varchar(100)
    Language : varchar(50)
    PageCount : int
}

entity "Authors" as Authors {
    * AuthorId : int <<PK>>
    --
    Name : varchar(100)
    Biography : varchar(1000)
}

entity "BookAuthors" as BookAuthors {
    * ProductId : int <<PK, FK>>
    * AuthorId : int <<PK, FK>>
}

' =========================
' Relationer
' =========================

Roles ||--o{ Users : "har"

Users ||--o| Customers : "kundeprofil"

Customers ||--o{ Orders : "opretter"

Orders ||--o{ OrderItems : "indeholder"
Orders ||--o| Payments : "betales via"

Products ||--o{ OrderItems : "sælges som"

Categories ||--o{ Products : "indeholder"
Categories ||--o{ Categories : "parent/child"

ProductStatus ||--o{ Products : "status"

Products ||--|| Inventory : "lager"
Products ||--o| BookDetails : "bogdetaljer"

BookDetails ||--o{ BookAuthors : "har"
Authors ||--o{ BookAuthors : "skriver"

' =========================
' Noter
' =========================

note right of ProductStatus
ProductStatus bruges til at afgøre
om et produkt kan sælges.

Eksempler:
- Active
- OutOfStock
- Discontinued
end note

note right of Products
Products er hovedtabellen
for alle salgbare varer.

Eksempler:
- Bog
- Notesbog
- Kuglepen
- Brætspil
end note

note bottom of OrderItems
UnitPrice gemmes her,
fordi produktets pris kan
ændre sig senere.

Ordren skal bevare købsprisen.
end note

note bottom of Orders
TotalAmount beregnes ud fra:

OrderItems.Quantity * OrderItems.UnitPrice
end note

note bottom of BookAuthors
BookAuthors er en koblingstabel
til mange-til-mange relationen
mellem bøger og forfattere.
end note

note right of Customers
FullName er ændret fra varchar(10)
til varchar(100), fordi 10 tegn
er for kort til et fuldt navn.
end note

@enduml