@startuml IdeenOgBogen - ERD
title IdeenOgBogen - Entity Relationship Diagram

left to right direction
hide circle

skinparam packageStyle rectangle
skinparam Shadowing false
skinparam classFontSize 12
skinparam classFontName Times New Roman
skinparam WrapWidth 260
skinparam linetype ortho

skinparam entity {
    BackgroundColor #F8F8F8
    BorderColor #333333
}

folder "IdeenOgBogen - Database Model" #Salmon {

    legend left
        Colors / stereotypes
        ---
        Salmon = IdeenOgBogen - Database Model
        Red = Users / Roles
        Yellow = Products / Categories
        LightGreen = Orders / Payments
        LightBlue = Books / Authors
        <<PK>>, <<FK>>, <<UNIQUE>>, <<nullable>>
    endlegend

    package "Users and Roles" #Red {

        entity "Roles" as Roles {
            * RoleId : int <<PK>>
            --
            RoleName : varchar(50) <<UNIQUE>>
        }

        entity "Users" as Users {
            * UserId : int <<PK>>
            --
            RoleId : int <<FK>>
            Username : varchar(50) <<UNIQUE>>
            Email : varchar(100) <<UNIQUE>>
            PasswordHash : varchar(255)
            IsActive : bit
            CreatedAt : datetime
        }

        entity "Customers" as Customers {
            * CustomerId : int <<PK>>
            --
            UserId : int <<FK, UNIQUE>>
            FullName : varchar(100)
            Phone : varchar(20)
            Address : varchar(150)
            PostalCode : varchar(20)
            City : varchar(50)
        }
    }

    package "Products and Categories" #Yellow {

        entity "Categories" as Categories {
            * CategoryId : int <<PK>>
            --
            ParentCategoryId : int <<FK, nullable>>
            Name : varchar(100)
            Description : varchar(255)
        }

        entity "ProductStatuses" as ProductStatuses {
            * ProductStatusId : int <<PK>>
            --
            StatusName : varchar(50)
            IsSellable : bit
        }

        entity "Products" as Products {
            * ProductId : int <<PK>>
            --
            CategoryId : int <<FK>>
            ProductStatusId : int <<FK>>
            Name : varchar(150)
            Description : varchar(500)
            Price : decimal(10,2)
            SKU : varchar(50) <<UNIQUE>>
            CreatedAt : datetime
        }

        entity "Inventory" as Inventory {
            * ProductId : int <<PK, FK>>
            --
            Quantity : int
            LastUpdated : datetime
        }
    }

    package "Orders and Payments" #LightGreen {

        entity "Orders" as Orders {
            * OrderId : int <<PK>>
            --
            CustomerId : int <<FK>>
            OrderDate : datetime
            OrderStatus : varchar(50)
            TotalAmount : decimal(10,2)
        }

        entity "OrderItems" as OrderItems {
            * OrderItemId : int <<PK>>
            --
            OrderId : int <<FK>>
            ProductId : int <<FK>>
            Quantity : int
            UnitPrice : decimal(10,2)
        }

        entity "Payments" as Payments {
            * PaymentId : int <<PK>>
            --
            OrderId : int <<FK, UNIQUE>>
            Amount : decimal(10,2)
            PaymentDate : datetime
            PaymentMethod : varchar(50)
            PaymentStatus : varchar(50)
        }
    }

    package "Books and Authors" #LightBlue {

        entity "BookDetails" as BookDetails {
            * ProductId : int <<PK, FK>>
            --
            ISBN : varchar(20) <<UNIQUE>>
            PublicationDate : date
            Publisher : varchar(100)
            Language : varchar(50)
            PageCount : int
        }

        entity "Authors" as Authors {
            * AuthorId : int <<PK>>
            --
            Name : varchar(100)
            Biography : varchar(1000)
        }

        entity "BookAuthors" as BookAuthors {
            * ProductId : int <<PK, FK>>
            * AuthorId : int <<PK, FK>>
        }
    }
}

Roles ||--o{ Users : has
Users ||--o| Customers : customer profile

Customers ||--o{ Orders : creates
Orders ||--o{ OrderItems : contains
Orders ||--o| Payments : paid by

Products ||--o{ OrderItems : sold as

Categories ||--o{ Products : contains
Categories ||--o{ Categories : parent / child

ProductStatuses ||--o{ Products : status

Products ||--|| Inventory : stock
Products ||--o| BookDetails : book details

BookDetails ||--o{ BookAuthors : has
Authors ||--o{ BookAuthors : writes

note right of ProductStatuses
ProductStatuses decides whether
a product can be sold.

Examples:
- Active
- OutOfStock
- Discontinued
end note

note right of Products
Products is the main table
for all sellable items.

Examples:
- Book
- Notebook
- Pen
- Board game
end note

note bottom of OrderItems
UnitPrice is stored here because
the product price may change later.

The order must keep the purchase price.
end note

note bottom of Orders
TotalAmount is calculated from:

OrderItems.Quantity * OrderItems.UnitPrice
end note

note bottom of BookAuthors
BookAuthors is a junction table
for the many-to-many relation
between books and authors.
end note

note right of Customers
FullName uses varchar(100)
because varchar(10) is too short
for a full customer name.
end note

@enduml